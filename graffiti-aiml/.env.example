# ==============================================================================
# Graffiti AI/ML Service - Environment Configuration Template
# ==============================================================================

APP_NAME="Graffiti AI/ML Service"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# FREE Model Provider Configuration (Google Gemini & Groq)
# ------------------------------------------------------------------------------
# Google Gemini (via Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Groq Cloud API (via Groq Console - https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# Optional Fallback Providers (OpenAI & Anthropic)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# Feature Flags & Offline Development
# ------------------------------------------------------------------------------
# When true or when keys are absent, uses offline deterministic heuristics & fallbacks
# Set to false once you add your GEMINI_API_KEY or GROQ_API_KEY to enable live cloud inference
ENABLE_MOCK_LLM=true

# ------------------------------------------------------------------------------
# Backend Integration
# ------------------------------------------------------------------------------
BACKEND_URL="http://localhost:8080"
BACKEND_TIMEOUT_SECONDS=8.0
