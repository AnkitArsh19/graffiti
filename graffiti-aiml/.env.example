# ==============================================================================
# Graffiti AI/ML Service - Environment Configuration Template
# ==============================================================================

APP_NAME="Graffiti AI/ML Service"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# FREE Model Provider Configuration (Google Gemini & Groq)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash (via Google AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq Cloud API (Llama 3.1 70B & 8B - https://console.groq.com/)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# ------------------------------------------------------------------------------
# Feature Flags & Offline Development
# ------------------------------------------------------------------------------
# When true or when keys are absent, uses offline deterministic heuristics & fallbacks
ENABLE_MOCK_LLM=true

# ------------------------------------------------------------------------------
# Backend Integration
# ------------------------------------------------------------------------------
BACKEND_URL="http://localhost:8080"
BACKEND_TIMEOUT_SECONDS=8.0
