# ==============================================================================
# Graffiti AI/ML Service - Environment Configuration Template
# ==============================================================================

APP_NAME="Graffiti AI/ML Service"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Google Gemini (Recommended)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI (Alternative Fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Anthropic (Optional)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# Feature Flags & Offline Development
# ------------------------------------------------------------------------------
# When true, uses offline deterministic templates and mocks if API keys are absent
ENABLE_MOCK_LLM=true

# ------------------------------------------------------------------------------
# Backend Integration
# ------------------------------------------------------------------------------
BACKEND_URL="http://localhost:8080"
BACKEND_TIMEOUT_SECONDS=8.0
