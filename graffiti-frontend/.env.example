# Graffiti Frontend Environment Configuration
# When running on custom domain (e.g. graffiti.ankitarsh.me via Cloudflare Tunnel)
# You can specify the public backend and websocket URLs:

# Backend API REST base (Defaults to https://api.graffiti.ankitarsh.me when hosted on *.ankitarsh.me, or http://localhost:8080 locally)
VITE_API_URL=https://api.graffiti.ankitarsh.me

# WebSocket STOMP endpoint (Defaults to wss://api.graffiti.ankitarsh.me/ws on domain, or ws://localhost:8080/ws locally)
VITE_WS_URL=wss://api.graffiti.ankitarsh.me/ws
